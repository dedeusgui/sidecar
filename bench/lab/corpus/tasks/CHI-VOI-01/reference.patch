 func matchAcceptEncoding(accepted []string, encoding string) bool {
 	for _, v := range accepted {
-		if strings.Contains(v, encoding) {
+		if strings.Contains(v, encoding) && !isRefusedEncoding(v) {
 			return true
 		}
 	}
 	return false
 }
+
+// isRefusedEncoding reports whether an Accept-Encoding entry has a q-value of 0,
+// which means the client does not accept that coding.
+func isRefusedEncoding(entry string) bool {
+	_, params, found := strings.Cut(entry, ";")
+	if !found {
+		return false
+	}
+	for _, param := range strings.Split(params, ";") {
+		key, value, ok := strings.Cut(strings.TrimSpace(param), "=")
+		if !ok || !strings.EqualFold(strings.TrimSpace(key), "q") {
+			continue
+		}
+		q, err := strconv.ParseFloat(strings.TrimSpace(value), 64)
+		return err == nil && q == 0
+	}
+	return false
+}
 
