+
+// routeExists reports whether path is routed for method or for any standard
+// method. A path routed only for other methods must reach the router, which
+// answers 405 Method Not Allowed as it does without this middleware.
+func routeExists(routes chi.Routes, method, path string) bool {
+	if routes.Match(chi.NewRouteContext(), method, path) {
+		return true
+	}
+	for _, m := range []string{
+		http.MethodGet, http.MethodHead, http.MethodPost, http.MethodPut,
+		http.MethodPatch, http.MethodDelete, http.MethodConnect,
+		http.MethodOptions, http.MethodTrace,
+	} {
+		if routes.Match(chi.NewRouteContext(), m, path) {
+			return true
+		}
+	}
+	return false
+}
